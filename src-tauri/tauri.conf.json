{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberCloak",
  "version": "0.1.0",
  "identifier": "local.cloakbrowser.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run runner:build && npm run runner:prepare-node && npm --prefix runner prune --omit=dev",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CyberCloak",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../runner/bin": "runner/bin",
      "../runner/dist": "runner/dist",
      "../runner/package.json": "runner/package.json",
      "../runner/node_modules": "runner/node_modules"
    }
  }
}
